# Required: OpenAI API key with access to a vision-capable model (e.g. gpt-4o)
OPENAI_API_KEY=your_api_key_here

# Optional overrides
OPENAI_MODEL=gpt-4o
PORT=5000

# Comma-separated list of origins allowed to call the API in production.
# In development the server already allows http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
