# Which AI provider to use for extraction: "openai" (default) or "gemini".
AI_PROVIDER=openai

# Required if AI_PROVIDER=openai: OpenAI key with access to a vision-capable
# model (e.g. gpt-4o)
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o

# Required if AI_PROVIDER=gemini: Gemini API key from
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Optional overrides
PORT=5000

# Comma-separated list of origins allowed to call the API in production.
# In development the server already allows http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
